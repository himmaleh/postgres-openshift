#cloud-config
bootcmd:
  - |
    cat > /usr/local/sbin/restore-postgres-quadlet.sh <<'SCRIPT'
    #!/bin/bash
    set -eu
    install -D -m 0644 /srv/postgres/config/postgres17.container /etc/containers/systemd/postgres17.container
    systemctl daemon-reload
    systemctl start postgres17.service
    SCRIPT
    chmod 0755 /usr/local/sbin/restore-postgres-quadlet.sh

    cat > /etc/systemd/system/restore-postgres-quadlet.service <<'UNIT'
    [Unit]
    Description=Restore PostgreSQL Quadlet from persistent disk
    After=cloud-final.service
    RequiresMountsFor=/srv/postgres/config

    [Service]
    Type=oneshot
    ExecStart=/usr/local/sbin/restore-postgres-quadlet.sh
    RemainAfterExit=yes

    [Install]
    WantedBy=multi-user.target
    UNIT

    systemctl daemon-reload
    systemctl enable restore-postgres-quadlet.service
mounts:
- [ "UUID=99c07ea6-7487-4872-96f2-da44b69644fa",
    "/srv/postgres", "xfs", "defaults", "0", "0" ]
chpasswd:
  expire: false
packages:
- qemu-guest-agent
password: ChangeMe123!
runcmd:
- systemctl enable --now qemu-guest-agent
ssh_authorized_keys:
- |
  ssh-rsa  sandbox@cnv
- |
  ssh-rsa  sandbox@cnv
ssh_pwauth: true
user: rhel10
